	   	            $k_kod = 22;
	   	   else if ($CurrencyCode== 'NOK' )
	   	            $k_kod = 26; 
	   	    else if ($CurrencyCode== 'JPY' )
	   	            $k_kod = 27; 
	   	   else if ($CurrencyCode== 'EUR' )
	   	            $k_kod = 32;    
	   	   else if ($CurrencyCode== 'GBP' ) {
	   	            $k_kod = 45;    
	   	            $CurrencyCode= 'STG';
	   	   } else if ($CurrencyCode== 'STG' ) {
	   	            $k_kod = 46;    }
			else if ($CurrencyCode== 'CNY' ) {
	   	    $k_kod = 76;    }
	   	       else if ($CurrencyCode== 'IRR' )
	   	            $k_kod = 47;     

	  
?>
                
                
                 <!-- foreign exchange              -->
              <tr>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
				<!--tarih yazýyor
				
				<?  $mstring =  "|".sprintf("%02d",$k_kod)."|" . date("mdY",strtotime( $Date)); echo  date("d/m/Y",strtotime( $Date));?>
                -->
				<? $mstring .= "|" . $CurrencyCode; echo $CurrencyCode    ?>
                </td>

                <td align="left" valign="middle" bgcolor="#F5F5F5">
                <nobr><? echo $CurrencyName    ?></nobr>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                 <? $mstring .= "|" .sprintf("%10.4lf",$ForexBuying); echo number_format($ForexBuying     ,5,".",",")?>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                <? $mstring .= "|" .sprintf("%10.4lf",$ForexSelling) ; echo number_format($ForexSelling    ,5,".",",")?>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                <? $mstring .= "|" .sprintf("%10.4lf",$BanknoteBuying) ; echo number_format($BanknoteBuying  ,5,".",",")?>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                <? $mstring .= "|" .sprintf("%10.4lf",$BanknoteSelling) ; echo number_format($BanknoteSelling ,5,".",",")?>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                <? echo number_format($CrossRateUSD    ,5,".",",")?>
                </td>
                <td align="center" valign="middle" bgcolor="#F5F5F5">
                <? echo number_format($CrossRateOther  ,5,".",",")?>
                </td>
                
                <? $mparite = 0+$CrossRateUSD + $CrossRateOther; 
                            $mstring .= "|".sprintf("%10.5lf",$mparite ) ;
                            if ($k_kod>0) 
                                fwrite($fptr,$mstring."|\n")?>
                    </tr>
                <? 
	  }	
	}
