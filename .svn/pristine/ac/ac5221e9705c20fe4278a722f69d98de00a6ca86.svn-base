if (!function_exists("GetSQLValueString")) {
function GetSQLValueString($theValue, $theType, $theDefinedValue = "", $theNotDefinedValue = "") 
{
  if (PHP_VERSION < 6) {
    $theValue = get_magic_quotes_gpc() ? stripslashes($theValue) : $theValue;
  }

  $theValue = function_exists("mysql_real_escape_string") ? mysql_real_escape_string($theValue) : mysql_escape_string($theValue);

  switch ($theType) {
    case "text":
      $theValue = ($theValue != "") ? "'" . $theValue . "'" : "NULL";
      break;    
    case "long":
    case "int":
      $theValue = ($theValue != "") ? intval($theValue) : "NULL";
      break;
    case "double":
      $theValue = ($theValue != "") ? doubleval($theValue) : "NULL";
      break;
    case "date":
      $theValue = ($theValue != "") ? "'" . $theValue . "'" : "NULL";
      break;
    case "defined":
      $theValue = ($theValue != "") ? $theDefinedValue : $theNotDefinedValue;
      break;
  }
  return $theValue;
}
}

$currentPage = $_SERVER["PHP_SELF"];

$maxRows_rc_finansal_raporlar = 10;
$pageNum_rc_finansal_raporlar = 0;
if (isset($_GET['pageNum_rc_finansal_raporlar'])) {
  $pageNum_rc_finansal_raporlar = $_GET['pageNum_rc_finansal_raporlar'];
}
$startRow_rc_finansal_raporlar = $pageNum_rc_finansal_raporlar * $maxRows_rc_finansal_raporlar;

mysql_select_db($database_connection_lcl, $connection_lcl);
$query_rc_finansal_raporlar = "SELECT * FROM finansal_raporlar";
$query_limit_rc_finansal_raporlar = sprintf("%s LIMIT %d, %d", $query_rc_finansal_raporlar, $startRow_rc_finansal_raporlar, $maxRows_rc_finansal_raporlar);
$rc_finansal_raporlar = mysql_query($query_limit_rc_finansal_raporlar, $connection_lcl) or die(mysql_error());

mysql_query("SET NAMES 'latin5'");  
mysql_query("SET CHARACTER SET latin5");  
mysql_query("SET COLLATION_CONNECTION = 'latin5_turkish_ci'");

$row_rc_finansal_raporlar = mysql_fetch_assoc($rc_finansal_raporlar);

if (isset($_GET['totalRows_rc_finansal_raporlar'])) {
  $totalRows_rc_finansal_raporlar = $_GET['totalRows_rc_finansal_raporlar'];
} else {
  $all_rc_finansal_raporlar = mysql_query($query_rc_finansal_raporlar);
  $totalRows_rc_finansal_raporlar = mysql_num_rows($all_rc_finansal_raporlar);
}
$totalPages_rc_finansal_raporlar = ceil($totalRows_rc_finansal_raporlar/$maxRows_rc_finansal_raporlar)-1;

$queryString_rc_finansal_raporlar = "";
if (!empty($_SERVER['QUERY_STRING'])) {
  $params = explode("&", $_SERVER['QUERY_STRING']);
  $newParams = array();
  foreach ($params as $param) {
    if (stristr($param, "pageNum_rc_finansal_raporlar") == false && 
        stristr($param, "totalRows_rc_finansal_raporlar") == false) {
      array_push($newParams, $param);
    }
  }
  if (count($newParams) != 0) {
    $queryString_rc_finansal_raporlar = "&" . htmlentities(implode("&", $newParams));
  }
}
$queryString_rc_finansal_raporlar = sprintf("&totalRows_rc_finansal_raporlar=%d%s", $totalRows_rc_finansal_raporlar, $queryString_rc_finansal_raporlar);
?>

