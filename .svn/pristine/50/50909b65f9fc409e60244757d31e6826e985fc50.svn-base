body

{

	background-image:url(../image/bg.png)

}

.bullet {

	list-style-image: url(../image/bullet.jpg);

	list-style-position: outside;

	list-style-type: none;

	font-family: Arial;

	font-size: 12px;

	color: #333;

	text-decoration: none;

	text-align: left;

}

.altmenu {

	color: #999;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}

a.altmenu1 {

	color: #999;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}

a.altmenu1:visited{

	color: #999;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}



a.altmenu1:link{

	color: #999;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}

a.altmenu1:active{

	color: #999;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}

a.altmenu1:hover{

	color:#CCC;

	text-align: left;

	margin-top: 10px;

	font-family: Arial;

	font-size: 10px;

}

#div_main {

	display: block;

	height:1385px;

	width:980px;

	border: 1px solid #000;

	position:relative;

	background-color:#fff;

	margin-top:10px;

	margin-left:auto;

	margin-right:auto;

}

#div_top {

	display: block;

	height: 102px;

	position: absolute;

	width:inherit;

	background-image: url(../image/top_Content.png);

	background-repeat:no-repeat;

	clear: both;

}







#div_menu {

	display: block;

	height: 35px;

	width:inherit;

	position:relative;

	top: 102px;

	background-repeat:repeat-x;

	color: #333;

	background-color: #FFFFFF;

}

#div_footer {

	

	position:absolute;

	height: 150px;

	width:980px;

	top: 2000px;

	font-family: Arial;

	font-size: 11px;

	text-align: center;

	padding-top: 3px;

	color: #FFF;

	padding-bottom: 0px;

	background-color:#333;

	margin-right: auto;

	margin-left: auto;

	left: 0px;

	right: 0px;

	bottom: 0px;

	padding-right: 0px;

	padding-left: 0px;

}

#div_footer_template {

	display: block;

	position:absolute;

	height: 30px;

	width:980px;

	top: 1350px;

	font-family: Arial;

	font-size: 11px;

	text-align: center;

	padding-top: 3px;

	color: #FFF;

	padding-bottom: 0px;

	background-color:#333;

	margin-right: auto;

	margin-left: auto;

	left: 0px;

	right: 0px;

	bottom: 0px;

	padding-right: 0px;

	padding-left: 0px;

	

}

#div_copyright {

	font-family: Arial;

	font-size: 11px;

	color: #999;

	background-color: #333;

	display: block;

	height: 50px;

	position: absolute;

	top:550px;

	padding: 10px;

	font-style: normal;

	text-align: center;

	vertical-align: bottom;

	white-space: pre;

}

#div_top_content {

	color: #FFF;

	font-family: Arial;

	font-size: 11px;

	text-align: right;

	vertical-align: top;

	display: block;

	height: 20px;

	width: 950px;

	padding-top: 5px;

	position:absolute;

	top: 5px;

	right: 5px;

	text-decoration: none;

}



#div_top_lang {

	color: #FFF;

	font-family: Arial;

	font-size: 12px;

	text-align: right;

	vertical-align: top;

	display: block;

	height: 25px;

	width: 950px;

	position:absolute;

	top: 25px;

	right: 5px;

	text-decoration: none;

	font-weight: bold;

}

#div_top_country {

	color:#FFF;

	font-family:coolveticarg;

	font-size: 12px;

	text-align:left;

	vertical-align: top;

	display: block;

	height: 20px;

	width: 200px;

	padding-top: 5px;

	position: absolute;

	top: 2px;

	left: 5px;

	text-decoration: none;

}



#div_content {

	background-color: #fff;

	display: block;

	position: absolute;

	height: 400px;

	width:980px;

	bottom: 0px;

	top: 800px;

	padding-top: 385px;

}



#div_top_content a:hover {

	color:#FFF;

	font-family: Arial;

	font-size: 11px;

	text-decoration: none;

}



a:link{

	text-decoration:none;

	font-family:arial;

	color:#FFF;

	font-size:11px;

}

a:link,a:visited,a:active{

	text-decoration:none;

	font-family:arial;

	color:#FFF;

	text-decoration:none;

	font-size:11px;

}



	

#div_icerik {

	background-color: #FFF;

	height: 270px;

	width: 980px;

	top: 370px;

	position: absolute;

	display: block;

	left: 0px;

	right: 0px;

	bottom: 0px;

}

#div_icerik_template {

	background-color: #FFF;

	height: 1000px;

	width: 980px;

	top: 370px;

	position: absolute;

	display: block;

	left: 0px;

	right: 0px;

	bottom: 0px;
	overflow:auto;
	

}

#div_icerik_left {

	height: 420px;

	width: 300px;

	position: absolute;

	background-color: #FFF;

	display: block;

	border: 1px solid #F2F2F2;

}

#div_icerik_left_iframe {

	background-color: #FFF;

	height: 100px;

	width: 300px;

	text-align: center;

	display: block;

	position: absolute;

	margin: 0px;

	left: 317px;

	top: 225px;

}



#div_icerik_right {

	height: 420px;

	width: 660px;

	position: absolute;

	left: 310px;

	display: block;

	background-color: #FFF;

	border: 1px solid #F2F2F2;

	margin-left: 5px;

}

.transparan img{

filter:Alpha(opacity=70);

-moz-opacity: 0.7;





-khtml-opacity: 0.7;

opacity: 0.7;



}





.transparan:hover img{

filter:Alpha(opacity=100);

-moz-opacity: 1;



-khtml-opacity: 1;

opacity: 1;

}

